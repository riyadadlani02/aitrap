    "on-handoff": [
      {"symbol": "livekit.agents.voice.agent_session.AgentSession.update_agent"},
      {"symbol": "livekit.agents.voice.agent_session.AgentSession._update_activity"}
    ],
    "on-user-turn": [
      {"symbol": "livekit.agents.voice.agent.Agent.on_user_turn_completed"}
    ]
  }
}
