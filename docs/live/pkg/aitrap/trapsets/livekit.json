      {"symbol": "livekit.agents.voice.tool_executor._ToolExecutor.execute"},
      {"symbol": "livekit.agents.voice.generation._execute_tools_task"}
    ],
    "on-llm-request": [
      {"symbol": "livekit.agents.llm.llm.LLM.chat"},
      {"symbol": "livekit.plugins.openai.llm.LLM.chat"}
